# Copy to api/.env and fill in. "npm run db" creates api/.env automatically for local development.

# PostgreSQL connection string, e.g. postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# Public address of the web app (used in e-mail links)
APP_URL=http://localhost:5173

# Optional: real SMTP server for e-mails. Without it, e-mails only go to the demo mailbox.
SMTP_URL=
MAIL_FROM=Randevu Platformu <noreply@randevu.test>

# Store sent e-mails in the database so the demo mailbox can show them
DEMO_OUTBOX=true
